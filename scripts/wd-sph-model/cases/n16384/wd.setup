# input file for tidal disruption setup

# units
           mass_unit = 1.e4*solarm    ! mass unit (e.g. solarm,jupiterm,1e6*solarm)

# options for central object
               mhole = 1.e4    ! mass of black hole (solar mass)
                racc = 1.65    ! accretion radius for the central object (code units or e.g. 1*km)

# how many bodies
              nstars =           1    ! number of bodies to add (0-2)

# options for body 1
           iprofile1 =           2    ! 0=Sink,1=Unif,2=Poly,3=Dens,4=KEPL,5=MESA,6=Piec
              Rstar1 = 0.0141*solarr    ! radius of body 1 (code units or e.g. 1 rsun)
              Mstar1 = 0.5*msun    ! mass of body 1 (code units or e.g. 1 msun)
                 np1 =        16384    ! number of particles

# equation of state used to set the thermal energy profile
                ieos =           2    ! 1=isothermal,2=idealgas,10=MESA,12=idealplusrad,23=Tillotson
               gamma =  1.66666667    ! Adiabatic index
                  mu = 1.75    ! mean molecular weight

# relaxation options
               relax =           T    ! relax bodies into equilibrium
            tol_ekin =   1.000E-07    ! tolerance on ekin/epot to stop relaxation
              maxits =        1000    ! maximum number of relaxation iterations
   write_rho_to_file =           T    ! write density profile(s) to file

# options for orbit around black hole
      provide_params = T    ! manually specify the position and velocity of the star(s)
                beta = 0.7212642582800765    ! penetration factor
              ecc_bh = .9    ! eccentricity (1 for parabolic)
            theta_bh =       0.000    ! inclination of orbit (degrees)
             norbits =       5.000    ! number of orbits
       dumpsperorbit =         100    ! number of dumps per orbit

# Exact equatorial Kerr orbit, prograde, initial radius=5rt
x1 = 90.162133878390577
y1 = 0
z1 = 0
vx1 = -0.10765261649899062
vy1 = 0.077541175388645342
vz1 = 0
